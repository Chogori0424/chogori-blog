[URL Rewrite]
# QQ音乐 / 开屏 / candidate / source L4905 / 实机未测试
^https?:\/\/y\.gtimg\.cn\/music\/common\/upload\/t_splash_info\/ - reject

[Map Local]
# 麦当劳 / 开屏 / candidate / source L6867 / 实机未测试
^https?:\/\/api\.mcd\.cn\/bff\/portal\/home\/splash data-type=text data=" " status-code=200
# 米家 / 开屏 / candidate / source L6956 / 实机未测试
^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/resource\/realtime\/openingBanner data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% y.gtimg.cn, api.mcd.cn, home.mi.com
