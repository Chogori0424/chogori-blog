---
import { AUTHOR_NAME, BLOG_CATEGORIES } from '../consts';

const today = new Date();
const columns = [
	{
		title: '浏览',
		links: [
			{ href: '/blog', label: '全部文章' },
			{ href: '/categories', label: '分类' },
		],
	},
	{
		title: '主题',
		links: BLOG_CATEGORIES.slice(0, 3).map((category) => ({
			href: `/categories/${category.slug}/`,
			label: category.name,
		})),
	},
	{
		title: '关于',
		links: [
			{ href: '/about', label: '关于我' },
			{ href: '/bot', label: '分身' },
			{ href: '/devlog', label: '开发日志' },
		],
	},
	{
		title: '订阅',
		links: [
			{ href: '/rss.xml', label: 'RSS' },
			{ href: '/sitemap-index.xml', label: 'Sitemap' },
		],
	},
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<nav class="footer-columns" aria-label="页脚导航">
			{
				columns.map((column) => (
					<div class="footer-column">
						<h2>{column.title}</h2>
						{column.links.map((link) => (
							<a href={link.href}>{link.label}</a>
						))}
					</div>
				))
			}
		</nav>
		<div class="footer-meta">
			<p>&copy; {today.getFullYear()} {AUTHOR_NAME}. 保留所有权利。</p>
			<p>静态站点，用 Astro 构建</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 36px 16px 48px;
		border-top: 1px solid var(--hairline);
		background: var(--color-footer);
		color: var(--color-text-muted);
		font-size: 12px;
		line-height: 1.6;
	}
	.footer-inner {
		display: grid;
		gap: 20px;
		max-width: var(--content-width);
		margin: 0 auto;
	}
	.footer-columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 24px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--color-border);
	}
	.footer-column {
		display: grid;
		align-content: start;
		gap: 10px;
	}
	.footer-column h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0;
	}
	.footer-column a {
		width: fit-content;
		color: var(--color-text-secondary);
	}
	.footer-column a:hover {
		color: var(--color-text);
		text-decoration: underline;
	}
	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px;
	}
	.footer-meta p {
		margin: 0;
	}
</style>
