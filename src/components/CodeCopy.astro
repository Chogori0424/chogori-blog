<script is:inline>
	const copiedText = '已复制';
	const defaultText = '复制';
	const resetDelay = 1600;

	const copyText = async (text: string) => {
		if (navigator.clipboard?.writeText && window.isSecureContext) {
			await navigator.clipboard.writeText(text);
			return;
		}

		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'fixed';
		textarea.style.top = '-9999px';
		document.body.appendChild(textarea);
		textarea.select();
		document.execCommand('copy');
		textarea.remove();
	};

	const enhanceCodeBlocks = () => {
		document.querySelectorAll<HTMLElement>('pre > code').forEach((code) => {
			const pre = code.parentElement;

			if (!pre || pre.parentElement?.classList.contains('code-block-wrapper')) {
				return;
			}

			if (code.classList.contains('language-surge')) {
				code.classList.add('language-ini');
				pre.dataset.language = 'ini';
			}

			const wrapper = document.createElement('div');
			wrapper.className = 'code-block-wrapper';
			pre.parentNode?.insertBefore(wrapper, pre);
			wrapper.appendChild(pre);

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'code-copy-button';
			button.textContent = defaultText;
			button.setAttribute('aria-label', '复制代码');
			wrapper.appendChild(button);

			let resetTimer: number | undefined;

			button.addEventListener('click', async () => {
				try {
					await copyText(code.textContent ?? '');
					button.textContent = copiedText;
					button.setAttribute('aria-label', '代码已复制');

					window.clearTimeout(resetTimer);
					resetTimer = window.setTimeout(() => {
						button.textContent = defaultText;
						button.setAttribute('aria-label', '复制代码');
					}, resetDelay);
				} catch {
					button.textContent = '复制失败';

					window.clearTimeout(resetTimer);
					resetTimer = window.setTimeout(() => {
						button.textContent = defaultText;
						button.setAttribute('aria-label', '复制代码');
					}, resetDelay);
				}
			});
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', enhanceCodeBlocks, { once: true });
	} else {
		enhanceCodeBlocks();
	}
</script>

<style is:global>
	.code-block-wrapper {
		position: relative;
	}

	.code-block-wrapper pre {
		padding-right: 5.5rem;
		overflow-x: auto;
	}

	.code-copy-button {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		z-index: 1;
		border: 1px solid var(--border-color);
		border-radius: 6px;
		padding: 0.2rem 0.55rem;
		background: var(--surface-soft);
		color: rgb(var(--gray-dark));
		font: inherit;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.4;
		cursor: pointer;
		backdrop-filter: blur(10px);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			opacity 0.2s ease;
	}

	.code-copy-button:hover,
	.code-copy-button:focus-visible {
		opacity: 1;
		background: var(--surface);
		color: rgb(var(--black));
	}
</style>
