---
// 分类图标：圆角方块 + 渐变底 + 白色线性图标，风格参考 iOS App 图标。
import { getCategoryByName } from '../consts';

interface Props {
	category: string;
	/** 图标方块边长（px） */
	size?: number;
	/** 方块圆角，默认沿用站点容器圆角 16px；大图标可传 24 */
	radius?: number;
	glow?: boolean;
	class?: string;
}

const { category, size = 56, radius, glow = false, class: className = '' } = Astro.props;
const meta = getCategoryByName(category);
const [from, to] = meta?.gradient ?? ['#8e8e93', '#636366'];
const icon = meta?.icon ?? 'notebook';
const glyph = Math.round(size * 0.48);
const corner = radius ?? (size >= 80 ? 24 : size >= 40 ? 16 : 10);
---

<span
	class:list={['category-icon', { 'category-icon--glow': glow }, className]}
	style={`--ci-size:${size}px;--ci-radius:${corner}px;--ci-from:${from};--ci-to:${to};`}
	aria-hidden="true"
>
	<svg
		width={glyph}
		height={glyph}
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		{
			icon === 'server' && (
				<>
					<rect x="4" y="3" width="16" height="7" rx="2" />
					<rect x="4" y="14" width="16" height="7" rx="2" />
					<path d="M8 6.5h.01M8 17.5h.01" />
				</>
			)
		}
		{
			icon === 'globe' && (
				<>
					<circle cx="12" cy="12" r="9" />
					<path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" />
				</>
			)
		}
		{
			icon === 'gear' && (
				<>
					<circle cx="12" cy="12" r="3" />
					<path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" />
				</>
			)
		}
		{
			icon === 'headphones' && (
				<>
					<path d="M4 15v-3a8 8 0 0 1 16 0v3" />
					<rect x="3" y="14" width="4" height="7" rx="1.5" />
					<rect x="17" y="14" width="4" height="7" rx="1.5" />
				</>
			)
		}
		{
			icon === 'sparkle' && (
				<>
					<path d="M12 3l2 5.5 5.5 2-5.5 2L12 18l-2-5.5-5.5-2 5.5-2z" />
					<path d="M19 17l.7 1.8 1.8.7-1.8.7L19 22l-.7-1.8-1.8-.7 1.8-.7z" />
				</>
			)
		}
		{
			icon === 'notebook' && (
				<>
					<path d="M6 3h11a2 2 0 0 1 2 2v16H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
					<path d="M8 8h7M8 12h7M8 16h4" />
				</>
			)
		}
	</svg>
</span>

<style>
	.category-icon {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: var(--ci-size);
		height: var(--ci-size);
		border-radius: var(--ci-radius);
		background: linear-gradient(160deg, var(--ci-from), var(--ci-to));
		color: #ffffff;
		box-shadow: 0 8px 20px color-mix(in srgb, var(--ci-to) 30%, transparent);
	}
	.category-icon--glow {
		box-shadow: 0 20px 60px color-mix(in srgb, var(--ci-to) 45%, transparent);
	}
</style>
