---
import { SITE_TITLE } from '../consts';
import Avatar from './Avatar.astro';
import HeaderLink from './HeaderLink.astro';
import ScrollMemoryButton from './ScrollMemoryButton.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/categories', label: '分类' },
	{ href: '/about', label: '关于' },
	{ href: '/bot', label: '分身' },
];
---

<header class="site-header" id="site-header">
	<nav class="site-nav glass" aria-label="主导航">
		<a class="site-brand" href="/">
			<Avatar variant="site" />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="nav-links">
			{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</div>
		<div class="nav-actions">
			<a class="icon-button" href="/blog#search" aria-label="搜索文章">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M20 20l-4-4"></path>
				</svg>
			</a>
			<ThemeToggle />
			<button
				class="icon-button menu-button"
				type="button"
				aria-label="打开菜单"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<path class="menu-line-1" d="M4 8h16"></path>
					<path class="menu-line-2" d="M4 16h16"></path>
				</svg>
			</button>
		</div>
	</nav>
	<div class="mobile-menu glass" id="mobile-menu" hidden>
		{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
	</div>
</header>
<ScrollMemoryButton />

<script>
	const header = document.getElementById('site-header');
	const menuButton = header?.querySelector<HTMLButtonElement>('.menu-button');
	const menu = document.getElementById('mobile-menu');

	// 滚动后导航栏收窄、玻璃加深
	const syncScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
	syncScrolled();
	window.addEventListener('scroll', syncScrolled, { passive: true });

	const setMenu = (open: boolean) => {
		if (!menu || !menuButton) return;
		menu.hidden = !open;
		header?.classList.toggle('menu-open', open);
		menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
		menuButton.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
	};
	menuButton?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenu(false);
	});
	document.addEventListener('click', (event) => {
		if (header && !header.contains(event.target as Node)) setMenu(false);
	});
</script>

<style>
	.site-header {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 50;
		width: min(var(--content-width), calc(100% - 24px));
		transform: translateX(-50%);
		transition: width 0.45s var(--ease-out), top 0.45s var(--ease-out);
	}
	.site-header.is-scrolled {
		top: 8px;
		width: min(980px, calc(100% - 24px));
	}
	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 56px;
		padding: 6px 6px 6px 12px;
		border-radius: var(--radius-pill);
		/* 胶囊导航：半透明底 + 12px 毛玻璃 */
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		backdrop-filter: saturate(180%) blur(12px);
		transition:
			background-color 0.35s ease,
			box-shadow 0.35s ease;
	}
	.is-scrolled .site-nav {
		background: var(--glass-bg-strong);
	}
	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
		color: var(--color-text);
		font-size: 16px;
		font-weight: 600;
		white-space: nowrap;
	}
	.site-brand:hover {
		color: var(--color-text);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 2px;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 2px;
	}
	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		transition: background-color 0.25s ease;
	}
	.icon-button:hover {
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
		color: var(--color-text);
	}
	.menu-button {
		display: none;
	}
	.menu-button path {
		transition: transform 0.3s var(--ease-out);
		transform-origin: center;
	}
	.menu-open .menu-line-1 {
		transform: translateY(4px) rotate(45deg);
	}
	.menu-open .menu-line-2 {
		transform: translateY(-4px) rotate(-45deg);
	}
	.mobile-menu {
		display: grid;
		gap: 2px;
		margin-top: 8px;
		padding: 8px;
		border-radius: var(--radius-card);
		background: var(--glass-bg-strong);
		animation: menu-in 0.3s var(--ease-out);
	}
	.mobile-menu[hidden] {
		display: none;
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (max-width: 760px) {
		.nav-links {
			display: none;
		}
		.menu-button {
			display: inline-flex;
		}
		.site-header,
		.site-header.is-scrolled {
			width: calc(100% - 24px);
		}
	}
	@media (min-width: 761px) {
		.mobile-menu {
			display: none !important;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.mobile-menu,
		.menu-button path {
			transition: none;
			animation: none;
		}
	}
</style>
