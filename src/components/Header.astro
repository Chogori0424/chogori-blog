---
import { SITE_TITLE } from '../consts';
import Avatar from './Avatar.astro';
import HeaderLink from './HeaderLink.astro';
import ScrollMemoryButton from './ScrollMemoryButton.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav aria-label="主导航">
		<h2>
			<a class="site-brand" href="/">
				<Avatar variant="site" />
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="nav-actions">
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/categories">分类</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
				<HeaderLink href="/bot">分身</HeaderLink>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<ScrollMemoryButton />
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: var(--header-shadow);
		transition: background-color 0.3s ease, color 0.3s ease;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		max-width: 1120px;
		margin: 0 auto;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-width: 0;
		margin-left: auto;
		color: var(--color-text);
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--color-text);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.3s ease, border-color 0.3s ease;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--color-accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.25rem 0.75rem;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			padding: 0.75rem 0;
		}
		.nav-actions {
			width: 100%;
			justify-content: flex-start;
		}
		.internal-links {
			justify-content: flex-start;
		}
		nav a {
			padding: 0.45rem 0.25rem;
			font-size: 0.92rem;
		}
	}
</style>
