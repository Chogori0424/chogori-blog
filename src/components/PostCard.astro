---
import type { CollectionEntry } from 'astro:content';
import { getCategoryByName } from '../consts';
import PostCover from './PostCover.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	/** row：左右图文（首页）；stack：上图下文（网格） */
	layout?: 'row' | 'stack';
	/** row 布局时图片放右侧 */
	reverse?: boolean;
	/** 更大的标题，用于分类页的置顶文章 */
	featured?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const { post, layout = 'stack', reverse = false, featured = false, headingLevel = 'h3' } = Astro.props;
const { title, description, category, pubDate } = post.data;
const href = `/blog/${post.id}/`;
const meta = getCategoryByName(category);
const dateText = pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const Heading = headingLevel;
---

<article
	class:list={['post-card', 'lift', 'zoom-cover', `post-card--${layout}`, { 'is-reverse': reverse, 'is-featured': featured }]}
	data-reveal
>
	<a class="post-card-cover" href={href} tabindex="-1" aria-hidden="true">
		<PostCover post={post} />
	</a>
	<div class="post-card-body">
		<a class="pill" href={meta ? `/categories/${meta.slug}/` : '/categories'}>{category}</a>
		<Heading class="post-card-title"><a href={href}>{title}</a></Heading>
		{description && <p class="post-card-excerpt">{description}</p>}
		<time class="post-card-date" datetime={pubDate.toISOString().slice(0, 10)}>{dateText}</time>
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--color-card-bg);
		box-shadow: var(--card-shadow);
	}
	.post-card--row {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.post-card--row.is-reverse {
		flex-direction: row-reverse;
	}
	.post-card-cover {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 9;
	}
	.post-card--row .post-card-cover {
		flex: 1 1 420px;
		aspect-ratio: auto;
		min-height: 300px;
	}
	.post-card--row.is-featured .post-card-cover {
		flex: 3 1 480px;
		min-height: 360px;
	}
	.post-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 12px;
		min-width: 0;
		padding: 28px;
	}
	.post-card--row .post-card-body {
		flex: 1 1 420px;
		padding: 40px;
	}
	.post-card--row.is-featured .post-card-body {
		flex: 2 1 340px;
	}
	.post-card-title {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.4;
		letter-spacing: 0;
	}
	.post-card--row .post-card-title {
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.35;
	}
	.post-card-title a {
		color: var(--color-text);
	}
	/* 整张卡片可点：标题链接的点击区域铺满卡片 */
	.post-card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.post-card .pill {
		position: relative;
		z-index: 1;
	}
	.post-card-excerpt {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.75;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
	}
	.post-card-date {
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		.post-card--row,
		.post-card--row.is-reverse {
			flex-direction: column;
			flex-wrap: nowrap;
		}
		.post-card--row .post-card-cover,
		.post-card--row.is-featured .post-card-cover {
			flex: none;
			width: 100%;
			min-height: 0;
			aspect-ratio: 16 / 9;
		}
		.post-card--row .post-card-body {
			flex: none;
			padding: 22px;
		}
	}
</style>
