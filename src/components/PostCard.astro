---
import type { CollectionEntry } from 'astro:content';
import { getCategoryByName } from '../consts';
import PostCover from './PostCover.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	/** row：左图右文（首页、分类页置顶）；stack：上图下文（网格） */
	layout?: 'row' | 'stack';
	/** 更大的标题和更宽的封面，用于分类页的置顶文章 */
	featured?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const { post, layout = 'stack', featured = false, headingLevel = 'h3' } = Astro.props;
const { title, description, category, pubDate } = post.data;
const href = `/blog/${post.id}/`;
const meta = getCategoryByName(category);
// 等宽纯数字日期，与 datetime 属性保持一致
const dateText = pubDate.toISOString().slice(0, 10);
const Heading = headingLevel;
---

<article class:list={['post-card', 'lift', 'zoom-cover', `post-card--${layout}`, { 'is-featured': featured }]} data-reveal>
	<a class="post-card-cover cover-frame" href={href} tabindex="-1" aria-hidden="true">
		<PostCover post={post} />
	</a>
	<div class="post-card-body">
		<a class="pill" href={meta ? `/categories/${meta.slug}/` : '/categories'}>{category}</a>
		<Heading class="post-card-title"><a href={href}>{title}</a></Heading>
		{description && <p class="post-card-excerpt">{description}</p>}
		<time class="post-card-date" datetime={dateText}>{dateText}</time>
	</div>
</article>

<style>
	.post-card {
		--card-pad: 10px;
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
		padding: var(--card-pad);
		border-radius: var(--radius-card);
		background: var(--color-card-bg);
		box-shadow: var(--card-shadow);
	}
	.post-card-cover {
		aspect-ratio: 16 / 10;
		border-radius: calc(var(--radius-card) - var(--card-pad));
	}

	/* 左图右文：图 40% / 文 60% */
	.post-card--row {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		align-items: center;
		gap: 8px;
	}
	.post-card--row.is-featured {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}

	.post-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
		min-width: 0;
		padding: 18px 16px 14px;
	}
	.post-card--row .post-card-body {
		padding: 16px 28px 16px 20px;
	}
	.post-card-title {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.45;
		letter-spacing: 0;
		text-wrap: pretty;
	}
	.post-card--row .post-card-title {
		font-size: clamp(1.2rem, 1.7vw, 1.4rem);
		line-height: 1.4;
	}
	.post-card--row.is-featured .post-card-title {
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
	}
	.post-card-title a {
		color: var(--color-text);
	}
	/* 整张卡片可点：标题链接的点击区域铺满卡片 */
	.post-card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.post-card .pill {
		position: relative;
		z-index: 1;
	}
	.post-card-excerpt {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}
	.post-card-date {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.01em;
	}
	@media (max-width: 720px) {
		.post-card--row,
		.post-card--row.is-featured {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		.post-card--row .post-card-body {
			padding: 18px 14px 12px;
		}
	}
</style>
