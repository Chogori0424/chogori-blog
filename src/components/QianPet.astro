<div id="qian-pet" class="qian-pet" data-mood="idle" aria-hidden="true">
	<div class="qian-bubble" role="status" aria-live="polite">我是倩</div>
	<button class="qian-close" type="button" aria-label="隐藏倩">×</button>
	<button class="qian-bot" type="button" aria-label="和倩互动">
		<span class="qian-antenna" aria-hidden="true"></span>
		<span class="qian-head" aria-hidden="true">
			<span class="qian-face">
				<span class="qian-eye"></span>
				<span class="qian-eye"></span>
			</span>
			<span class="qian-signal"></span>
		</span>
		<span class="qian-body" aria-hidden="true">
			<span class="qian-panel"></span>
			<span class="qian-arm qian-arm-left"></span>
			<span class="qian-arm qian-arm-right"></span>
			<span class="qian-heart">♥</span>
		</span>
		<span class="qian-base" aria-hidden="true"></span>
	</button>
</div>

<script>
	const qianPet = document.getElementById('qian-pet');

	if (qianPet) {
		const storageKey = 'qianPetHidden';
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const bot = qianPet.querySelector('.qian-bot');
		const closeButton = qianPet.querySelector('.qian-close');
		const bubble = qianPet.querySelector('.qian-bubble');
		const messages = [
			'我是倩',
			'今天也要保持输出',
			'继续写点什么吧',
			'我在看着部署状态',
			'这篇文章可以再打磨一下',
			'规则、代码、文章，都可以沉淀',
			'已在后台待命',
			'别忘了更新开发日志',
		];
		const moods = ['blink', 'heart', 'jump', 'shake'];
		const idleMoods = ['blink', 'breathe', 'shake'];

		let moodTimer = null;
		let bubbleTimer = null;
		let idleTimer = null;
		let lastMessage = '';

		const randomItem = (items) => items[Math.floor(Math.random() * items.length)];

		const setFocusable = (enabled) => {
			if (bot) bot.tabIndex = enabled ? 0 : -1;
			if (closeButton) closeButton.tabIndex = enabled ? 0 : -1;
		};

		const showBubble = (message = randomItem(messages), delay = 2600) => {
			if (!bubble) return;

			const nextMessage = message === lastMessage ? randomItem(messages) : message;
			lastMessage = nextMessage;
			bubble.textContent = nextMessage;
			qianPet.classList.add('has-bubble');

			window.clearTimeout(bubbleTimer);
			bubbleTimer = window.setTimeout(() => {
				qianPet.classList.remove('has-bubble');
			}, delay);
		};

		const setMood = (mood, duration = 900) => {
			window.clearTimeout(moodTimer);
			qianPet.dataset.mood = mood;

			moodTimer = window.setTimeout(() => {
				qianPet.dataset.mood = 'idle';
			}, duration);
		};

		const scheduleIdle = () => {
			if (reduceMotion) return;

			window.clearTimeout(idleTimer);
			idleTimer = window.setTimeout(
				() => {
					setMood(randomItem(idleMoods), 900);
					scheduleIdle();
				},
				8000 + Math.floor(Math.random() * 7000),
			);
		};

		const reveal = () => {
			qianPet.hidden = false;
			qianPet.removeAttribute('aria-hidden');
			setFocusable(true);
			scheduleIdle();
		};

		if (localStorage.getItem(storageKey) === 'true') {
			qianPet.hidden = true;
			setFocusable(false);
		} else {
			reveal();
		}

		qianPet.addEventListener('mouseenter', () => {
			showBubble(randomItem(messages), 2200);
		});

		qianPet.addEventListener('focusin', () => {
			showBubble('我是倩', 2200);
		});

		bot?.addEventListener('click', () => {
			setMood(randomItem(moods), 1000);
			showBubble(randomItem(messages), 3000);
		});

		closeButton?.addEventListener('click', (event) => {
			event.stopPropagation();
			localStorage.setItem(storageKey, 'true');
			qianPet.hidden = true;
			qianPet.setAttribute('aria-hidden', 'true');
			setFocusable(false);
			window.clearTimeout(moodTimer);
			window.clearTimeout(bubbleTimer);
			window.clearTimeout(idleTimer);
		});
	}
</script>

<style>
