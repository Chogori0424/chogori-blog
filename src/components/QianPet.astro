	}

	.qian-mark-n {
		background: linear-gradient(90deg, var(--qian-accent-strong) 0 28%, transparent 28% 42%, var(--qian-accent-strong) 42% 58%, transparent 58% 72%, var(--qian-accent-strong) 72%);
	}

	.qian-core {
		position: absolute;
		right: 8px;
		top: 21px;
		width: 6px;
		height: 6px;
		border-radius: 999px;
