		--qian-shell: #2f63ee;
		--qian-shell-light: #6689ff;
		--qian-shell-deep: #1d3fae;
		--qian-face: rgba(7, 13, 29, 0.9);
		--qian-border: rgba(34, 211, 238, 0.38);
		--qian-text: #e5e7eb;
		--qian-scale: 1;
		--qian-pixel-shadow:
			0 0 0 1px rgba(34, 211, 238, 0.18),
