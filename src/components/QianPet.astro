		width: 20px;
		height: 13px;
		border-radius: 5px;
		background: linear-gradient(180deg, #5577f4, #263fb2);
		box-shadow: inset -2px -2px 0 rgba(8, 18, 56, 0.16);
	}

	.qian-body {
		position: absolute;
		left: 27px;
		top: 75px;
		width: 50px;
		height: 34px;
		border: 2px solid rgba(103, 232, 249, 0.33);
		border-radius: 12px 12px 16px 16px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 32%),
			linear-gradient(180deg, #5877ff, #2449d8);
		box-shadow:
			inset -3px -4px 0 rgba(8, 18, 56, 0.18),
			var(--qian-pixel-shadow);
	}

	.qian-badge {
		position: absolute;
		left: 11px;
		top: 8px;
		display: grid;
		grid-template-columns: repeat(4, 5px);
