<div id="qian-pet" class="qian-pet" data-mood="idle" data-spirit="steady" aria-hidden="true">
	<div class="qian-bubble" role="status" aria-live="polite">继续写点什么吧</div>
	<button class="qian-close" type="button" aria-label="关闭倩">×</button>
	<button class="qian-bot" type="button" aria-label="倩，小宠物助手">
		<span class="qian-shadow" aria-hidden="true"></span>
		<span class="qian-head" aria-hidden="true">
			<span class="qian-top-gem"></span>
			<span class="qian-ear qian-ear-left"></span>
			<span class="qian-ear qian-ear-right"></span>
			<span class="qian-face">
				<span class="qian-eye qian-eye-left"></span>
				<span class="qian-eye qian-eye-right"></span>
				<span class="qian-mouth"></span>
				<span class="qian-blush qian-blush-left"></span>
				<span class="qian-blush qian-blush-right"></span>
			</span>
			<span class="qian-hairpin"></span>
		</span>
		<span class="qian-neck" aria-hidden="true"></span>
		<span class="qian-body" aria-hidden="true">
			<span class="qian-badge">
				<span class="qian-mark qian-mark-q"></span>
				<span class="qian-mark qian-mark-i"></span>
				<span class="qian-mark qian-mark-a"></span>
				<span class="qian-mark qian-mark-n"></span>
			</span>
			<span class="qian-core"></span>
		</span>
		<span class="qian-arm qian-arm-left" aria-hidden="true"></span>
		<span class="qian-arm qian-arm-right" aria-hidden="true"></span>
		<span class="qian-heart" aria-hidden="true"></span>
		<span class="qian-leg qian-leg-left" aria-hidden="true"></span>
		<span class="qian-leg qian-leg-right" aria-hidden="true"></span>
	</button>
</div>

<script>
	const qianPet = document.getElementById('qian-pet');

	if (qianPet) {
		const hiddenKey = 'qianPetHidden';
		const positionKey = 'qianPetPosition';
		const moodKey = 'qianPetMood';
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const bot = qianPet.querySelector('.qian-bot');
		const closeButton = qianPet.querySelector('.qian-close');
		const bubble = qianPet.querySelector('.qian-bubble');

		const spiritMessages = {
			morning: [
				'早安，今天也要保持输出',
				'新的一天，继续沉淀一点东西吧',
				'先从一处小细节开始推进',
			],
			noon: [
				'中午了，记得适当休息',
				'进度还顺利吗？',
				'休息一下再继续，效率会更稳',
			],
			afternoon: [
				'下午适合继续打磨细节',
				'我还在线，继续迭代吧',
				'这个时间段适合处理复杂一点的问题',
			],
			evening: [
				'晚上好，适合慢慢整理思路',
				'今晚也要写点什么吗？',
				'把今天的改动沉淀下来会很有用',
			],
			night: [
				'夜深了，别太辛苦',
				'记得保存进度，也记得休息',
				'我有点困了，但还在待命',
			],
		};

		const generalMessages = [
			'继续写点什么吧',
			'今天也要保持输出',
			'已在后台待命',
			'别忘了更新开发日志',
			'规则、代码、文章，都可以沉淀',
			'这篇文章还可以再打磨一下',
			'我在看着部署状态',
			'换个位置继续待命',
		];

		const interactionMoods = ['blink', 'heart', 'hop', 'sway', 'happy'];
		const idleMoods = ['blink', 'breathe', 'float', 'idle-hop', 'sway'];

		let moodTimer = null;
		let bubbleTimer = null;
		let idleTimer = null;
		let touchTimer = null;
		let dragState = null;
		let suppressNextClick = false;
		let lastMessage = '';
		let lastBubbleAt = 0;
		let lastInteractionAt = 0;

		const randomItem = (items) => items[Math.floor(Math.random() * items.length)];

		const getSpirit = () => {
			const hour = new Date().getHours();

			if (hour >= 5 && hour <= 10) return 'morning';
			if (hour >= 11 && hour <= 13) return 'noon';
			if (hour >= 14 && hour <= 17) return 'afternoon';
			if (hour >= 18 && hour <= 22) return 'evening';
			return 'night';
		};

		const setSpirit = () => {
			const spirit = getSpirit();
			qianPet.dataset.spirit = spirit;
			localStorage.setItem(moodKey, spirit);
			return spirit;
		};

		const getIdleDelay = () => {
			const spirit = qianPet.dataset.spirit;

			if (spirit === 'morning') return 8000 + Math.floor(Math.random() * 7000);
			if (spirit === 'night') return 14000 + Math.floor(Math.random() * 9000);
			return 10000 + Math.floor(Math.random() * 8000);
		};

		const getMessagePool = (kind = 'mixed') => {
			const spiritPool = spiritMessages[qianPet.dataset.spirit] || spiritMessages.afternoon;

			if (kind === 'spirit') return spiritPool;
			if (kind === 'general') return generalMessages;
			return [...spiritPool, ...generalMessages];
		};

		const pickMessage = (kind = 'mixed') => {
			const pool = getMessagePool(kind);
			let nextMessage = randomItem(pool);

			if (pool.length > 1 && nextMessage === lastMessage) {
				nextMessage = randomItem(pool.filter((item) => item !== lastMessage));
			}

			lastMessage = nextMessage;
			return nextMessage;
		};

		const setFocusable = (enabled) => {
			if (bot) bot.tabIndex = enabled ? 0 : -1;
			if (closeButton) closeButton.tabIndex = enabled ? 0 : -1;
		};

		const showBubble = (message = pickMessage('mixed'), delay = 3200, force = false) => {
			if (!bubble) return;

			const now = Date.now();
			const cooldown = force ? 700 : 5200;

			if (!force && now - lastBubbleAt < cooldown) return;

			lastBubbleAt = now;
			bubble.textContent = message;
			qianPet.classList.add('has-bubble');

			window.clearTimeout(bubbleTimer);
			bubbleTimer = window.setTimeout(() => {
				qianPet.classList.remove('has-bubble');
			}, delay);
		};

		const setMood = (mood, duration = 900) => {
			window.clearTimeout(moodTimer);
			qianPet.dataset.mood = mood;

			if (duration > 0) {
				moodTimer = window.setTimeout(() => {
					qianPet.dataset.mood = 'idle';
				}, reduceMotion ? Math.min(duration, 180) : duration);
			}
		};

		const clampPosition = (left, top) => {
			const margin = 10;
			const width = qianPet.offsetWidth || 112;
			const height = qianPet.offsetHeight || 140;
			const maxLeft = Math.max(margin, window.innerWidth - width - margin);
			const maxTop = Math.max(margin, window.innerHeight - height - margin);

			return {
				left: Math.min(Math.max(left, margin), maxLeft),
				top: Math.min(Math.max(top, margin), maxTop),
			};
		};

		const setPosition = (left, top) => {
			const next = clampPosition(left, top);
			qianPet.style.left = `${next.left}px`;
			qianPet.style.top = `${next.top}px`;
			qianPet.style.right = 'auto';
			qianPet.style.bottom = 'auto';
			return next;
		};

		const applyStoredPosition = () => {
			try {
				const raw = localStorage.getItem(positionKey);
				if (!raw) return;

				const position = JSON.parse(raw);
				if (Number.isFinite(position.left) && Number.isFinite(position.top)) {
					setPosition(position.left, position.top);
				}
			} catch {
				localStorage.removeItem(positionKey);
			}
		};

		const savePosition = () => {
			const rect = qianPet.getBoundingClientRect();
			const position = clampPosition(rect.left, rect.top);
			localStorage.setItem(positionKey, JSON.stringify(position));
		};

		const scheduleIdle = () => {
			window.clearTimeout(idleTimer);
			if (reduceMotion) return;

			idleTimer = window.setTimeout(() => {
				if (document.hidden || qianPet.dataset.mood === 'walk') {
					scheduleIdle();
					return;
				}

				setSpirit();
				setMood(randomItem(idleMoods), 900);

				if (Date.now() - lastBubbleAt > 26000 && Math.random() > 0.65) {
					showBubble(pickMessage('spirit'), 2800);
				}

				scheduleIdle();
			}, getIdleDelay());
		};

		const reveal = () => {
			setSpirit();
			qianPet.hidden = false;
			qianPet.removeAttribute('aria-hidden');
			setFocusable(true);
			window.setTimeout(applyStoredPosition, 0);
			window.setTimeout(() => {
				showBubble(pickMessage('spirit'), 3400, true);
			}, 900);
			scheduleIdle();
		};

		const hideForSession = () => {
			localStorage.setItem(hiddenKey, 'true');
			qianPet.hidden = true;
			qianPet.setAttribute('aria-hidden', 'true');
			qianPet.classList.remove('has-bubble', 'is-touch-ready', 'is-dragging');
			setFocusable(false);
			window.clearTimeout(moodTimer);
			window.clearTimeout(bubbleTimer);
			window.clearTimeout(idleTimer);
			window.clearTimeout(touchTimer);
		};

		const startDrag = (event) => {
			if (event.button !== 0 || event.pointerType === 'touch') return;

			const rect = qianPet.getBoundingClientRect();
			dragState = {
				pointerId: event.pointerId,
				startX: event.clientX,
				startY: event.clientY,
				left: rect.left,
				top: rect.top,
				dragging: false,
			};

			bot?.setPointerCapture?.(event.pointerId);
		};

		const moveDrag = (event) => {
			if (!dragState || event.pointerId !== dragState.pointerId) return;

			const deltaX = event.clientX - dragState.startX;
			const deltaY = event.clientY - dragState.startY;
			const distance = Math.hypot(deltaX, deltaY);

			if (!dragState.dragging && distance > 5) {
				dragState.dragging = true;
				qianPet.classList.add('is-dragging');
				setMood('walk', 0);
				showBubble('换个位置继续待命', 1800, true);
				document.body.style.userSelect = 'none';
			}

			if (!dragState.dragging) return;

			event.preventDefault();
			setPosition(dragState.left + deltaX, dragState.top + deltaY);
		};

		const endDrag = (event) => {
			if (!dragState || event.pointerId !== dragState.pointerId) return;

			bot?.releasePointerCapture?.(event.pointerId);

			if (dragState.dragging) {
				savePosition();
				suppressNextClick = true;
				qianPet.classList.remove('is-dragging');
				qianPet.dataset.mood = 'idle';
				document.body.style.userSelect = '';
				window.setTimeout(() => {
					suppressNextClick = false;
				}, 120);
			}

			dragState = null;
		};

		if (localStorage.getItem(hiddenKey) === 'true') {
			qianPet.hidden = true;
			setFocusable(false);
		} else {
			reveal();
		}

		qianPet.addEventListener('mouseenter', () => {
			showBubble(pickMessage('mixed'), 2800);
		});

		qianPet.addEventListener('focusin', () => {
			showBubble(pickMessage('general'), 2600, true);
		});

		qianPet.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'touch') return;

			qianPet.classList.add('is-touch-ready');
			showBubble(pickMessage('mixed'), 3000, true);

			window.clearTimeout(touchTimer);
			touchTimer = window.setTimeout(() => {
				qianPet.classList.remove('is-touch-ready');
			}, 4200);
		});

		bot?.addEventListener('pointerdown', startDrag);
		bot?.addEventListener('pointermove', moveDrag);
		bot?.addEventListener('pointerup', endDrag);
		bot?.addEventListener('pointercancel', endDrag);

		bot?.addEventListener('click', () => {
			if (suppressNextClick) return;

			const now = Date.now();
			if (now - lastInteractionAt < 420) return;

			lastInteractionAt = now;
			setMood(randomItem(interactionMoods), 1050);
			showBubble(pickMessage('mixed'), 3500, true);
		});

		closeButton?.addEventListener('click', (event) => {
			event.stopPropagation();
			hideForSession();
		});

		window.addEventListener('resize', () => {
			if (qianPet.hidden || !qianPet.style.top) return;
			savePosition();
			applyStoredPosition();
		});
	}
</script>

<style>
