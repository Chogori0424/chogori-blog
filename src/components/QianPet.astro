<div id="qian-pet" class="qian-pet" data-mood="idle" aria-hidden="true">
	<div class="qian-bubble" role="status" aria-live="polite">我是倩</div>
	<button class="qian-close" type="button" aria-label="关闭倩">×</button>
	<button class="qian-bot" type="button" aria-label="倩，小宠物助手">
		<span class="qian-shadow" aria-hidden="true"></span>
		<span class="qian-antenna" aria-hidden="true"></span>
		<span class="qian-head" aria-hidden="true">
			<span class="qian-ear qian-ear-left"></span>
			<span class="qian-ear qian-ear-right"></span>
			<span class="qian-face">
				<span class="qian-eye qian-eye-left"></span>
				<span class="qian-eye qian-eye-right"></span>
				<span class="qian-mouth"></span>
				<span class="qian-blush qian-blush-left"></span>
				<span class="qian-blush qian-blush-right"></span>
			</span>
			<span class="qian-hairpin"></span>
		</span>
		<span class="qian-body" aria-hidden="true">
			<span class="qian-panel"></span>
			<span class="qian-core"></span>
			<span class="qian-arm qian-arm-left"></span>
			<span class="qian-arm qian-arm-right"></span>
			<span class="qian-hand qian-hand-left"></span>
			<span class="qian-hand qian-hand-right"></span>
			<span class="qian-heart">◆</span>
		</span>
		<span class="qian-foot qian-foot-left" aria-hidden="true"></span>
		<span class="qian-foot qian-foot-right" aria-hidden="true"></span>
	</button>
</div>

<script>
	const qianPet = document.getElementById('qian-pet');

	if (qianPet) {
		const storageKey = 'qianPetHidden';
		const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		const reduceMotion = reduceMotionQuery.matches;
		const bot = qianPet.querySelector('.qian-bot');
		const closeButton = qianPet.querySelector('.qian-close');
		const bubble = qianPet.querySelector('.qian-bubble');

		const greetingMessages = {
			morning: [
				'早安，今天也要保持输出',
				'早上好，要从哪篇开始更新？',
				'新的一天，继续沉淀一点东西吧',
			],
			noon: [
				'中午好，记得适当休息',
				'午间巡航中，项目进度还顺利吗？',
				'吃完饭也可以顺手写一点',
			],
			afternoon: [
				'下午好，适合继续推进功能',
				'倩已待命，继续迭代吧',
				'这个时间段很适合优化细节',
			],
			evening: [
				'晚上好，适合慢慢打磨内容',
				'今晚也要继续写点什么吗？',
				'这个时段很适合整理思路',
			],
			night: [
				'夜深了，也别太辛苦',
				'深夜模式已开启，注意休息',
				'如果还在折腾，记得保存进度',
			],
		};

		const generalMessages = [
			'我是倩',
			'继续写点什么吧',
			'今天也要保持输出',
			'已在后台待命',
			'别忘了更新开发日志',
			'规则、代码、文章，都可以沉淀',
			'这篇文章还可以再打磨一下',
			'我在看着部署状态',
		];

		const interactionMoods = ['blink', 'heart', 'jump', 'shake', 'wave'];
		const idleMoods = ['blink', 'breathe', 'tilt'];

		let moodTimer = null;
		let bubbleTimer = null;
		let idleTimer = null;
		let touchTimer = null;
		let lastMessage = '';
		let lastBubbleAt = 0;
		let lastInteractionAt = 0;

		const randomItem = (items) => items[Math.floor(Math.random() * items.length)];

		const getGreetingType = () => {
			const hour = new Date().getHours();

			if (hour >= 5 && hour <= 10) return 'morning';
			if (hour >= 11 && hour <= 13) return 'noon';
			if (hour >= 14 && hour <= 18) return 'afternoon';
			if (hour >= 19 && hour <= 23) return 'evening';
			return 'night';
		};

		const getMessagePool = (kind = 'general') => {
			if (kind === 'greeting') {
				return greetingMessages[getGreetingType()] || greetingMessages.afternoon;
			}

			if (kind === 'mixed') {
				return [...generalMessages, ...getMessagePool('greeting')];
			}

			return generalMessages;
		};

		const pickMessage = (kind = 'mixed') => {
			const pool = getMessagePool(kind);
			let nextMessage = randomItem(pool);

			if (pool.length > 1 && nextMessage === lastMessage) {
				nextMessage = randomItem(pool.filter((item) => item !== lastMessage));
			}

			lastMessage = nextMessage;
			return nextMessage;
		};

		const setFocusable = (enabled) => {
			if (bot) bot.tabIndex = enabled ? 0 : -1;
			if (closeButton) closeButton.tabIndex = enabled ? 0 : -1;
		};

		const showBubble = (message = pickMessage('mixed'), delay = 3200, force = false) => {
			if (!bubble) return;

			const now = Date.now();
			const cooldown = force ? 900 : 4800;

			if (!force && now - lastBubbleAt < cooldown) return;

			lastBubbleAt = now;
			bubble.textContent = message;
			qianPet.classList.add('has-bubble');

			window.clearTimeout(bubbleTimer);
			bubbleTimer = window.setTimeout(() => {
				qianPet.classList.remove('has-bubble');
			}, delay);
		};

		const setMood = (mood, duration = 900) => {
			window.clearTimeout(moodTimer);
			qianPet.dataset.mood = mood;

			moodTimer = window.setTimeout(() => {
				qianPet.dataset.mood = 'idle';
			}, reduceMotion ? 180 : duration);
		};

		const scheduleIdle = () => {
			window.clearTimeout(idleTimer);
			if (reduceMotion) return;

			idleTimer = window.setTimeout(
				() => {
					if (document.hidden) {
						scheduleIdle();
						return;
					}

					setMood(randomItem(idleMoods), 850);

					if (Date.now() - lastBubbleAt > 24000 && Math.random() > 0.62) {
						showBubble(pickMessage('general'), 2600);
					}

					scheduleIdle();
				},
				10000 + Math.floor(Math.random() * 8000),
			);
		};

		const reveal = () => {
			qianPet.hidden = false;
			qianPet.removeAttribute('aria-hidden');
			setFocusable(true);

			window.setTimeout(() => {
				showBubble(pickMessage('greeting'), 3600, true);
			}, 900);

			scheduleIdle();
		};

		const hideForSession = () => {
			localStorage.setItem(storageKey, 'true');
			qianPet.hidden = true;
			qianPet.setAttribute('aria-hidden', 'true');
			qianPet.classList.remove('has-bubble', 'is-touch-ready');
			setFocusable(false);
			window.clearTimeout(moodTimer);
			window.clearTimeout(bubbleTimer);
			window.clearTimeout(idleTimer);
			window.clearTimeout(touchTimer);
		};

		if (localStorage.getItem(storageKey) === 'true') {
			qianPet.hidden = true;
			setFocusable(false);
		} else {
			reveal();
		}

		qianPet.addEventListener('mouseenter', () => {
			showBubble(pickMessage('mixed'), 2800);
		});

		qianPet.addEventListener('focusin', () => {
			showBubble('我是倩', 2600, true);
		});

		qianPet.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'touch') return;

			qianPet.classList.add('is-touch-ready');
			showBubble(pickMessage('mixed'), 3000, true);

			window.clearTimeout(touchTimer);
			touchTimer = window.setTimeout(() => {
				qianPet.classList.remove('is-touch-ready');
			}, 4200);
		});

		bot?.addEventListener('click', () => {
			const now = Date.now();
			if (now - lastInteractionAt < 420) return;

			lastInteractionAt = now;
			setMood(randomItem(interactionMoods), 1050);
			showBubble(pickMessage('mixed'), 3600, true);
		});

		closeButton?.addEventListener('click', (event) => {
			event.stopPropagation();
			hideForSession();
		});
	}
</script>

