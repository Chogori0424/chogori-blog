		position: fixed;
		left: 20px;
		bottom: 24px;
		z-index: 45;
		width: 116px;
		height: 148px;
		color: var(--qian-text);
		pointer-events: none;
	}

	.qian-pet[hidden] {
		display: none;
	}

	.qian-pet[data-spirit='morning'] {
		--qian-accent: #38e8ff;
		--qian-accent-strong: #a5f3fc;
	}

	.qian-pet[data-spirit='afternoon'] {
		--qian-accent: #2dd4bf;
		--qian-accent-strong: #99f6e4;
	}

	.qian-pet[data-spirit='evening'] {
		--qian-accent: #8bd8ff;
		--qian-accent-strong: #bae6fd;
		--qian-pink: #f0abfc;
	}

	.qian-pet[data-spirit='night'] {
		--qian-accent: #7dd3fc;
		--qian-accent-strong: #bfdbfe;
		--qian-pink: #d8b4fe;
