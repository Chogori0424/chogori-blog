---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);

const categories = BLOG_CATEGORIES.map((category) => ({
	...category,
	count: posts.filter((post) => post.data.category === category.name).length,
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
				gap: 2rem;
				align-items: start;
				margin-bottom: 2.5rem;
			}
			.kicker {
				margin: 0 0 0.65rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				font-weight: 700;
			}
			.hero h1 {
				margin: 0 0 1rem;
				font-size: 3rem;
			}
			.hero p {
				max-width: 760px;
				margin: 0 0 1rem;
			}
			.profile-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.25rem;
			}
			.profile-meta span,
			.category-card span:first-of-type,
			.post-category {
				display: inline-flex;
				border-radius: 999px;
				padding: 0.18rem 0.62rem;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.82rem;
				font-weight: 700;
			}
			.profile-panel,
			.site-note {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--surface-soft);
				padding: 1.1rem;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.profile-panel h2,
			.site-note h2,
			.section-title {
				margin: 0 0 0.85rem;
				font-size: 1.35rem;
			}
			.profile-panel p,
			.site-note p {
				margin: 0;
				font-size: 0.95rem;
			}
			.section {
				margin-top: 2.5rem;
			}
			.latest-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				overflow: hidden;
				height: 100%;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--surface);
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.post-card a {
				display: grid;
				grid-template-columns: 180px minmax(0, 1fr);
				height: 100%;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.post-card img {
				width: 100%;
				height: 100%;
				min-height: 180px;
				object-fit: cover;
				border-radius: 0;
			}
			.post-body {
				padding: 1rem;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				align-items: center;
				margin-bottom: 0.65rem;
				color: rgb(var(--gray));
				font-size: 0.82rem;
			}
			.post-body h3 {
				margin: 0 0 0.55rem;
				font-size: 1.15rem;
			}
			.post-body p {
				margin: 0;
				font-size: 0.95rem;
			}
			.direction-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.category-card {
				display: grid;
				gap: 0.55rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--surface-soft);
				padding: 1rem;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.category-card strong {
				color: rgb(var(--black));
				font-size: 1.05rem;
			}
			.category-card p {
				margin: 0;
				font-size: 0.92rem;
			}
			.site-note {
				display: grid;
				gap: 0.75rem;
			}
			.site-note a {
				font-weight: 700;
			}
			@media (max-width: 900px) {
				.hero,
				.latest-list,
				.direction-grid {
					grid-template-columns: 1fr;
				}
				.hero h1 {
					font-size: 2.25rem;
				}
				.post-card a {
					grid-template-columns: 1fr;
				}
				.post-card img {
					height: auto;
					min-height: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<p class="kicker">chogori.xyz / 个人技术博客</p>
					<h1>{SITE_TITLE}</h1>
					<p>
						我是 Chogori Lee，模具注塑工艺工程师。这里记录网络代理配置、工程制造、CAD/UG、
						音频设备和个人知识管理相关的实践笔记。
					</p>
					<p>
						站点会优先保留问题背景、排查过程、配置取舍和后续维护思路，让零散经验变成能长期复用的资料。
					</p>
					<div class="profile-meta">
						<span>Surge / Quantumult X</span>
						<span>Siemens NX / UG</span>
						<span>模具注塑工艺</span>
						<span>音频设备</span>
					</div>
				</div>
				<aside class="profile-panel">
					<h2>个人简介</h2>
					<p>
						关注把工程现场经验和日常技术折腾写成可检索、可复盘、可迁移的内容。博客采用 Astro
						静态站点方案，文章以 Markdown/MDX 管理。
					</p>
				</aside>
			</section>

			<section class="section">
				<h2 class="section-title">最新文章</h2>
				<ul class="latest-list">
					{
						latestPosts.map((post) => (
							<li>
								<article class="post-card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={360} height={240} src={post.data.heroImage} alt="" />
										)}
										<div class="post-body">
											<div class="post-meta">
												<span class="post-category">{post.data.category}</span>
												<FormattedDate date={post.data.pubDate} />
											</div>
											<h3>{post.data.title}</h3>
											<p>{post.data.description}</p>
										</div>
									</a>
								</article>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<h2 class="section-title">技术方向</h2>
				<div class="direction-grid">
					{
						categories.map((category) => (
							<a class="category-card" href={`/categories/${category.slug}/`}>
								<span>{category.count} 篇</span>
								<strong>{category.name}</strong>
								<p>{category.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="section site-note">
				<h2>站点说明</h2>
				<p>
					{SITE_URL} 当前是静态优先的个人博客，不使用 WordPress、不接入数据库、不引入复杂 CMS。
					内容文件保存在仓库中，所有变更都可以通过 Git diff 审阅。
				</p>
				<p>
					<a href="/rss.xml">RSS</a> 可用于订阅更新，<a href="/sitemap-index.xml">sitemap</a>
					用于帮助搜索引擎发现公开页面。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
