---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import {
	AUTHOR_AVATAR,
	AUTHOR_NAME,
	BLOG_CATEGORIES,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SITE_URL,
} from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);

const categories = BLOG_CATEGORIES.map((category) => ({
	...category,
	count: posts.filter((post) => post.data.category === category.name).length,
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
				gap: 2rem;
				align-items: start;
				margin-bottom: 2.5rem;
			}
			.kicker {
				margin: 0 0 0.65rem;
				color: var(--color-text-muted);
				font-size: 0.9rem;
				font-weight: 700;
			}
			.hero h1 {
				margin: 0 0 1rem;
				font-size: 3rem;
			}
			.hero p {
				max-width: 760px;
				margin: 0 0 1rem;
			}
			.profile-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.25rem;
			}
			.profile-meta span,
			.category-card span:first-of-type {
				display: inline-flex;
				border: 1px solid var(--color-accent);
				border-radius: 999px;
				padding: 0.18rem 0.62rem;
				background: var(--color-accent-muted);
				color: var(--color-text);
				font-size: 0.82rem;
				font-weight: 700;
			}
			.profile-panel,
			.site-note {
				border: 1px solid var(--color-card-border);
				border-radius: 8px;
				background: var(--surface-soft);
				padding: 1.1rem;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.profile-panel {
				display: grid;
				grid-template-columns: 88px minmax(0, 1fr);
				grid-template-areas:
					'title title'
					'photo intro';
				gap: 0.95rem 1rem;
				align-items: start;
			}
			.profile-photo {
				grid-area: photo;
				width: 88px;
				aspect-ratio: 1;
				border: 1px solid var(--color-card-border);
				border-radius: 8px;
				object-fit: cover;
				object-position: center;
			}
			.profile-panel h2,
			.site-note h2,
			.section-title {
				margin: 0 0 0.85rem;
				font-size: 1.35rem;
			}
			.profile-panel h2 {
				grid-area: title;
				margin-bottom: 0;
			}
			.profile-panel p,
			.site-note p {
				margin: 0;
				font-size: 0.95rem;
			}
			.profile-panel p {
				grid-area: intro;
			}
			.section {
				margin-top: 2.5rem;
			}
			.latest-list {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
				align-items: stretch;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.latest-list > li {
				min-width: 0;
				height: 100%;
			}
			.direction-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.category-card {
				display: grid;
				gap: 0.55rem;
				border: 1px solid var(--color-card-border);
				border-radius: 8px;
				background: var(--surface-soft);
				padding: 1rem;
				color: var(--color-text);
				text-decoration: none;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.category-card strong {
				color: var(--color-text);
				font-size: 1.05rem;
			}
			.category-card:hover {
				border-color: var(--color-accent);
			}
			.category-card p {
				margin: 0;
				font-size: 0.92rem;
			}
			.site-note {
				display: grid;
				gap: 0.75rem;
			}
			.site-note a {
				font-weight: 700;
			}
			@media (min-width: 768px) {
				.latest-list {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 900px) {
				.hero,
				.direction-grid {
					grid-template-columns: 1fr;
				}
				.hero h1 {
					font-size: 2.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div>
					<p class="kicker">chogori.xyz / 个人技术博客</p>
					<h1>{SITE_TITLE}</h1>
					<p>
						我是 {AUTHOR_NAME}，模具注塑工艺工程师。这里记录网络代理配置、工程制造、CAD/UG、
						音频设备和个人知识管理相关的实践笔记。
					</p>
					<p>
						站点会优先保留问题背景、排查过程、配置取舍和后续维护思路，让零散经验变成能长期复用的资料。
					</p>
					<div class="profile-meta">
						<span>Surge / Quantumult X</span>
						<span>Siemens NX / UG</span>
						<span>模具注塑工艺</span>
						<span>音频设备</span>
					</div>
				</div>
				<aside class="profile-panel">
					<img class="profile-photo" src={AUTHOR_AVATAR} alt={AUTHOR_NAME} width="88" height="88" />
					<h2>个人简介</h2>
					<p>
						关注把工程现场经验和日常技术折腾写成可检索、可复盘、可迁移的内容。博客采用 Astro
						静态站点方案，文章以 Markdown/MDX 管理。
					</p>
				</aside>
			</section>

			<section class="section">
				<h2 class="section-title">最新文章</h2>
				<ul class="latest-list">
					{latestPosts.map((post) => <li><PostCard post={post} /></li>)}
				</ul>
			</section>

			<section class="section">
				<h2 class="section-title">技术方向</h2>
				<div class="direction-grid">
					{
						categories.map((category) => (
							<a class="category-card" href={`/categories/${category.slug}/`}>
								<span>{category.count} 篇</span>
								<strong>{category.name}</strong>
								<p>{category.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="section site-note">
				<h2>站点说明</h2>
				<p>
					{SITE_URL} 当前是静态优先的个人博客，不使用 WordPress、不接入数据库、不引入复杂 CMS。
					内容文件保存在仓库中，所有变更都可以通过 Git diff 审阅。
				</p>
				<p>
					<a href="/rss.xml">RSS</a> 可用于订阅更新，<a href="/sitemap-index.xml">sitemap</a>
					用于帮助搜索引擎发现公开页面。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
