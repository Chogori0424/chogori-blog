---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import {
	AUTHOR_AVATAR,
	AUTHOR_NAME,
	BLOG_CATEGORIES,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);

const categories = BLOG_CATEGORIES.map((category) => {
	const categoryPosts = posts
		.filter((post) => post.data.category === category.name)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return {
		...category,
		count: categoryPosts.length,
		latestPost: categoryPosts[0],
	};
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2rem);
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
				gap: 2rem;
				align-items: start;
				margin-bottom: 2.5rem;
			}
			.hero-copy {
				min-width: 0;
			}
			.kicker {
				margin: 0 0 0.65rem;
				color: var(--color-text-muted);
				font-size: 0.9rem;
				font-weight: 700;
			}
			.hero-title-row {
				display: flex;
				gap: 1rem;
				align-items: center;
				margin-bottom: 1rem;
			}
			.hero-avatar {
				width: 72px;
				height: 72px;
				flex: 0 0 auto;
				border: 1px solid var(--color-card-border);
				border-radius: var(--radius-pill);
				object-fit: cover;
				object-position: center;
			}
			.hero h1 {
				margin: 0;
				font-size: 3rem;
				line-height: 1.08;
			}
			.hero p {
				max-width: 760px;
				margin: 0 0 1rem;
			}
			.profile-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.25rem;
			}
			.profile-meta span {
				display: inline-flex;
				border: 1px solid var(--color-accent);
				border-radius: var(--radius-pill);
				padding: 0.18rem 0.62rem;
				background: var(--color-accent-muted);
				color: var(--color-text);
				font-size: 0.82rem;
				font-weight: 700;
			}
			.hero-cta,
			.category-card,
			.rss-cta {
				border: 1px solid var(--color-card-border);
				border-radius: var(--radius-card);
				background: var(--surface-soft);
				padding: 1.1rem;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease,
					transform 0.2s ease;
			}
			.hero-cta {
				display: grid;
				gap: 0.85rem;
				align-content: start;
				margin-top: clamp(4rem, 6vw, 5rem);
			}
			.hero-cta:hover,
			.category-card:hover,
			.rss-cta:hover {
				border-color: var(--color-accent);
			}
			.cta-eyebrow {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.85rem;
				font-weight: 800;
			}
			.hero-cta h2 {
				margin: 0;
				font-size: 1.5rem;
				line-height: 1.35;
			}
			.primary-cta,
			.rss-cta-button {
				display: inline-flex;
				width: fit-content;
				align-items: center;
				justify-content: center;
				border: 1px solid var(--color-accent);
				border-radius: var(--radius-pill);
				background: var(--color-accent);
				color: var(--color-bg);
				font-weight: 800;
				line-height: 1;
				text-decoration: none;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
			}
			.primary-cta {
				padding: 0.8rem 1rem;
			}
			.rss-cta-button {
				padding: 0.75rem 0.95rem;
				white-space: nowrap;
			}
			.primary-cta:hover,
			.rss-cta-button:hover {
				transform: translateY(-2px);
			}
			.rss-subtle-link {
				width: fit-content;
				color: var(--color-text-muted);
				font-size: 0.92rem;
				font-weight: 800;
				text-decoration-color: var(--color-accent);
				text-underline-offset: 0.2em;
			}
			.section-title,
			.rss-cta h2 {
				margin: 0 0 0.85rem;
				font-size: 1.35rem;
			}
			.section {
				margin-top: 2.5rem;
			}
			.latest-list {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
				align-items: stretch;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.latest-list > li {
				min-width: 0;
				height: 100%;
			}
			.direction-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.category-card {
				display: grid;
				align-content: start;
				gap: 0.55rem;
				border-radius: var(--radius-container);
				color: var(--color-text);
			}
			.category-card h3 {
				margin: 0;
				font-size: 1.05rem;
			}
			.category-card a {
				color: var(--color-text);
				font-weight: 800;
				text-decoration-color: var(--color-accent);
				text-underline-offset: 0.2em;
			}
			.category-count {
				margin: 0 0 0.1rem;
				color: var(--color-accent);
				font-size: 2.5rem;
				font-weight: 900;
				line-height: 1;
			}
			.category-card p {
				margin: 0;
				font-size: 0.92rem;
			}
			.latest-post {
				border-top: 1px solid var(--color-card-border);
				padding-top: 0.75rem;
				color: var(--color-text-muted);
			}
			.latest-post span {
				font-weight: 800;
			}
			.latest-post a {
				color: var(--color-text);
			}
			.rss-cta {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: center;
			}
			.rss-icon {
				display: inline-flex;
				width: 3rem;
				height: 3rem;
				align-items: center;
				justify-content: center;
				border: 1px solid var(--color-accent);
				border-radius: var(--radius-pill);
				background: var(--color-accent-muted);
				color: var(--color-accent);
			}
			.rss-cta h2 {
				margin-bottom: 0.35rem;
			}
			.rss-cta p {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.95rem;
			}
			@media (min-width: 768px) {
				.latest-list {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 900px) {
				.hero,
				.direction-grid {
					grid-template-columns: 1fr;
				}
				.rss-cta {
					grid-template-columns: 1fr;
				}
				.hero-cta {
					margin-top: 0;
				}
				.hero h1 {
					font-size: 2.25rem;
				}
			}
			@media (max-width: 520px) {
				.hero-title-row {
					gap: 0.75rem;
				}
				.hero-avatar {
					width: 56px;
					height: 56px;
				}
				.hero h1 {
					font-size: 2rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.primary-cta,
				.rss-cta-button,
				.category-card {
					transition: none;
				}
				.primary-cta:hover,
				.rss-cta-button:hover {
					transform: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="kicker">chogori.xyz / 个人技术博客</p>
					<div class="hero-title-row">
						<img class="hero-avatar" src={AUTHOR_AVATAR} alt={AUTHOR_NAME} width="72" height="72" />
						<h1>{SITE_TITLE}</h1>
					</div>
					<p>
						我是 {AUTHOR_NAME}，模具注塑工艺工程师。这里记录网络代理配置、工程制造、CAD/UG、
						音频设备和个人知识管理相关的实践笔记。
					</p>
					<p>
						站点会优先保留问题背景、排查过程、配置取舍和后续维护思路，让零散经验变成能长期复用的资料。
					</p>
					<div class="profile-meta">
						<span>Surge / Quantumult X</span>
						<span>Siemens NX / UG</span>
						<span>模具注塑工艺</span>
						<span>音频设备</span>
					</div>
				</div>
				<aside class="hero-cta" aria-label="文章入口">
					<p class="cta-eyebrow">从文章开始</p>
					<h2>按时间查看技术记录，或用 RSS 跟进后续更新。</h2>
					<a class="primary-cta" href="/blog">查看所有文章 →</a>
					<a class="rss-subtle-link" href="/rss.xml">RSS 订阅</a>
				</aside>
			</section>

			<section class="section">
				<h2 class="section-title">最新文章</h2>
				<ul class="latest-list">
					{latestPosts.map((post) => <li><PostCard post={post} /></li>)}
				</ul>
			</section>

			<section class="section">
				<h2 class="section-title">技术方向</h2>
				<div class="direction-grid">
					{
						categories.map((category) => (
							<article class="category-card">
								<div>
									<p class="category-count" aria-label={`${category.count} 篇文章`}>
										{category.count}
									</p>
									<h3>
										<a href={`/categories/${category.slug}/`}>{category.name}</a>
									</h3>
								</div>
								<p>{category.description}</p>
								<p class="latest-post">
									{category.latestPost ? (
										<>
											<span>最新：</span>
											<a href={`/blog/${category.latestPost.id}/`}>{category.latestPost.data.title}</a>
										</>
									) : (
										<span>最新：待整理</span>
									)}
								</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="section rss-cta" aria-labelledby="rss-cta-title">
				<div class="rss-icon" aria-hidden="true">
					<svg
						viewBox="0 0 24 24"
						width="26"
						height="26"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<path d="M4 11a9 9 0 0 1 9 9" />
						<path d="M4 4a16 16 0 0 1 16 16" />
						<circle cx="5" cy="19" r="1" />
					</svg>
				</div>
				<div>
					<h2 id="rss-cta-title">订阅 RSS，获取最新文章更新</h2>
					<p>新文章发布后可通过 RSS 阅读器跟进，适合长期保存和跨设备同步。</p>
				</div>
				<a class="rss-cta-button" href="/rss.xml">订阅 RSS</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
