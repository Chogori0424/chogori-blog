---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import PostCard from '../components/PostCard.astro';
import { AUTHOR_ROLE, BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				position: relative;
				display: flex;
				min-height: max(640px, 100svh);
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: calc(var(--header-height) + 24px) 16px 140px;
				text-align: center;
				color: #ffffff;
			}
			.hero-content {
				position: relative;
				z-index: 1;
				display: flex;
				width: 100%;
				max-width: 760px;
				flex-direction: column;
				align-items: center;
				gap: 22px;
			}
			.hero-eyebrow {
				padding: 6px 14px;
				border: 1px solid rgba(255, 255, 255, 0.3);
				border-radius: var(--radius-pill);
				background: rgba(10, 25, 50, 0.32);
				-webkit-backdrop-filter: blur(12px);
				backdrop-filter: blur(12px);
				font-size: 13px;
			}
			.hero h1 {
				margin: 0;
				color: #ffffff;
				font-size: clamp(3rem, 8vw, 5rem);
				line-height: 1.05;
				letter-spacing: -0.03em;
				text-shadow: 0 4px 30px rgba(10, 25, 50, 0.35);
			}
			.hero-tagline {
				margin: 0;
				color: rgba(255, 255, 255, 0.92);
				font-size: clamp(1.05rem, 2vw, 1.3rem);
				text-shadow: 0 2px 16px rgba(10, 25, 50, 0.35);
			}
			.hero-search {
				display: flex;
				width: 100%;
				max-width: 560px;
				height: 56px;
				margin-top: 12px;
				align-items: center;
				gap: 12px;
				padding: 0 8px 0 22px;
				border-radius: var(--radius-pill);
				color: var(--color-text-muted);
				cursor: text;
				transition:
					box-shadow 0.3s ease,
					transform 0.3s var(--ease-out);
			}
			.hero-search:focus-within {
				transform: scale(1.02);
				box-shadow:
					0 0 0 4px color-mix(in srgb, var(--color-brand) 35%, transparent),
					var(--glass-shadow);
			}
			.hero-search input {
				flex: 1;
				min-width: 0;
				border: 0;
				background: transparent;
				color: var(--color-text);
				font-size: 17px;
				outline: none;
			}
			.hero-search input::placeholder {
				color: var(--color-text-muted);
			}
			.hero-search kbd {
				padding: 6px 10px;
				border-radius: var(--radius-pill);
				background: color-mix(in srgb, var(--color-text) 7%, transparent);
				color: var(--color-text-muted);
				font-family: var(--font-sans);
				font-size: 12px;
			}
			.scroll-cue {
				position: absolute;
				bottom: 32px;
				left: 50%;
				z-index: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 6px;
				transform: translateX(-50%);
				color: var(--color-text-secondary);
				font-size: 13px;
			}
			.scroll-cue svg {
				animation: nudge 2.4s var(--ease-out) infinite;
			}
			@keyframes nudge {
				0%,
				60%,
				100% {
					transform: none;
				}
				30% {
					transform: translateY(5px);
				}
			}

			.topics {
				padding: 64px 16px 80px;
			}
			.topics-inner {
				display: flex;
				max-width: 1040px;
				margin: 0 auto;
				flex-direction: column;
				align-items: center;
				gap: 40px;
			}
			.topics h2 {
				margin: 0;
				font-size: clamp(1.75rem, 3vw, 2.5rem);
			}
			.topic-grid {
				display: grid;
				width: 100%;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 12px;
			}
			.topic-tile {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 14px;
				padding: 28px 12px;
				border-radius: var(--radius-card);
				background: var(--color-bg-secondary);
				color: var(--color-text);
				font-size: 15px;
				font-weight: 500;
				transition:
					transform 0.35s var(--ease-out),
					background-color 0.35s ease;
			}
			.topic-tile:hover {
				transform: translateY(-4px) scale(1.02);
				background: var(--color-bg-hover);
				color: var(--color-text);
			}

			.latest {
				padding: 80px 16px;
				background: var(--color-section-alt);
			}
			.latest-inner {
				display: grid;
				max-width: var(--content-width);
				margin: 0 auto;
				gap: 28px;
			}
			.latest-inner .section-head {
				margin-bottom: 0;
			}

			.subscribe {
				padding: 64px 16px;
			}
			.subscribe .notice {
				max-width: var(--content-width);
				margin: 0 auto;
			}

			@media (max-width: 720px) {
				.hero {
					padding-bottom: 120px;
				}
				.topic-grid {
					grid-template-columns: repeat(3, minmax(0, 1fr));
					gap: 10px;
				}
				.topic-tile {
					padding: 18px 6px;
					font-size: 13px;
					gap: 10px;
				}
				.topic-tile :global(.category-icon) {
					--ci-size: 52px !important;
				}
				.latest {
					padding: 56px 16px;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.scroll-cue svg {
					animation: none;
				}
				.topic-tile,
				.topic-tile:hover,
				.hero-search,
				.hero-search:focus-within {
					transform: none;
					transition: none;
				}
			}
		</style>
	</head>
	<body class="has-hero">
		<Header />
		<main style="width: 100%; max-width: 100%; padding: 0;">
			<section class="hero">
				<HeroBackdrop />
				<div class="hero-content">
					<span class="hero-eyebrow rise">{AUTHOR_ROLE}的技术笔记</span>
					<h1 class="rise d1">{SITE_TITLE}</h1>
					<p class="hero-tagline rise d2">{SITE_TAGLINE}</p>
					<form class="hero-search glass rise d3" action="/blog" method="get" role="search">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="M20 20l-4-4"></path>
						</svg>
						<label class="sr-only" for="hero-search-input">搜索文章</label>
						<input id="hero-search-input" name="q" type="search" placeholder="搜索文章、配置、工具…" autocomplete="off" />
						<kbd aria-hidden="true">/</kbd>
					</form>
				</div>
				<a class="scroll-cue rise d4" href="#latest">
					开始阅读
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 9l6 6 6-6"></path>
					</svg>
				</a>
			</section>

			<section class="topics" aria-labelledby="topics-title">
				<div class="topics-inner">
					<h2 id="topics-title" data-reveal>按主题浏览</h2>
					<div class="topic-grid">
						{
							BLOG_CATEGORIES.map((category, index) => (
								<a
									class="topic-tile"
									href={`/categories/${category.slug}/`}
									data-reveal
									style={`--reveal-delay:${index * 0.05}s`}
								>
									<CategoryIcon category={category.name} size={64} />
									<span>{category.name}</span>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<section class="latest" id="latest" aria-labelledby="latest-title">
				<div class="latest-inner">
					<div class="section-head" data-reveal>
						<h2 id="latest-title">最新文章</h2>
						<a class="link-more" href="/blog">查看全部文章</a>
					</div>
					{latestPosts.map((post, index) => <PostCard post={post} layout="row" reverse={index % 2 === 1} />)}
				</div>
			</section>

			<section class="subscribe">
				<div class="notice" data-reveal>
					<span>新文章会第一时间出现在 RSS 里，适合用阅读器长期跟进、跨设备同步。</span>
					<a class="link-more" href="/rss.xml">订阅 RSS</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// 按 / 键聚焦首屏搜索框
			const input = document.getElementById('hero-search-input') as HTMLInputElement | null;
			document.addEventListener('keydown', (event) => {
				const target = event.target as HTMLElement;
				const typing = target.closest('input, textarea, [contenteditable="true"]');
				if (event.key === '/' && !typing && input) {
					event.preventDefault();
					input.focus();
				}
			});
		</script>
	</body>
</html>
