---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { getReadingMinutes } from '../../consts';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const toNeighbor = (post?: CollectionEntry<'blog'>) =>
		post ? { title: post.data.title, href: `/blog/${post.id}/` } : undefined;

	// 按时间倒序：上一篇是更早的文章，下一篇是更新的文章
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: { post, prev: toNeighbor(posts[index + 1]), next: toNeighbor(posts[index - 1]) },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: { title: string; href: string };
	next?: { title: string; href: string };
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = getReadingMinutes(post.body);
---

<BlogPost {...post.data} headings={headings} readingMinutes={readingMinutes} prev={prev} next={next}>
	<Content />
</BlogPost>
