---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1040px;
			}
			.page-head {
				margin-bottom: 2rem;
			}
			.page-head h1 {
				margin-bottom: 0.75rem;
				font-size: 2.4rem;
			}
			.page-head p {
				max-width: 760px;
				margin: 0;
			}
			.category-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1rem;
			}
			.category-nav a {
				border: 1px solid var(--color-accent);
				border-radius: 999px;
				padding: 0.35rem 0.75rem;
				background: var(--color-accent-muted);
				color: var(--color-text);
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition:
					background-color 0.3s ease,
					border-color 0.3s ease,
					color 0.3s ease;
			}
			.category-nav a:hover {
				border-color: var(--color-accent-hover);
				background: var(--color-bg-hover);
			}
			.post-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
				align-items: stretch;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-grid > li {
				min-width: 0;
				height: 100%;
			}
			@media (min-width: 768px) {
				.post-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<h1>全部文章</h1>
				<p>按时间查看 Chogori Blog 的技术记录。栏目用于保持写作边界清晰，文章内容仍然以问题、过程和结论为主。</p>
				<nav class="category-nav" aria-label="文章栏目">
					{BLOG_CATEGORIES.map((category) => <a href={`/categories/${category.slug}/`}>{category.name}</a>)}
				</nav>
			</section>

			<ul class="post-grid">
				{posts.map((post) => <li><PostCard post={post} /></li>)}
			</ul>
		</main>
		<Footer />
	</body>
</html>
