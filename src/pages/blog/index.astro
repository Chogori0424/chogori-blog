---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1040px;
			}
			.page-head {
				margin-bottom: 2rem;
			}
			.page-head h1 {
				margin-bottom: 0.75rem;
				font-size: 2.4rem;
			}
			.page-head p {
				max-width: 760px;
				margin: 0;
			}
			.category-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1rem;
			}
			.category-nav a {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.35rem 0.75rem;
				background: white;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				overflow: hidden;
				height: 100%;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: white;
			}
			.post-card a {
				display: grid;
				height: 100%;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.post-card img {
				display: block;
				width: 100%;
				border-radius: 0;
			}
			.post-body {
				padding: 1rem;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.badge {
				display: inline-flex;
				border-radius: 999px;
				padding: 0.15rem 0.55rem;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-weight: 700;
			}
			.post-body h2 {
				margin: 0 0 0.55rem;
				font-size: 1.35rem;
			}
			.post-body p {
				margin: 0;
			}
			@media (max-width: 760px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<h1>全部文章</h1>
				<p>按时间查看 Chogori Blog 的技术记录。栏目用于保持写作边界清晰，文章内容仍然以问题、过程和结论为主。</p>
				<nav class="category-nav" aria-label="文章栏目">
					{BLOG_CATEGORIES.map((category) => <a href={`/categories/${category.slug}/`}>{category.name}</a>)}
				</nav>
			</section>

			<ul class="post-grid">
				{
					posts.map((post) => (
						<li>
							<article class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="post-body">
										<div class="meta">
											<span class="badge">{post.data.category}</span>
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
									</div>
								</a>
							</article>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
