---
import { Image } from 'astro:assets';
import type { ImageMetadata, MarkdownHeading } from 'astro';
import Avatar from '../components/Avatar.astro';
import BaseHead from '../components/BaseHead.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, getCategoryByName } from '../consts';

interface NeighborPost {
	title: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata | string;
	category?: string;
	tags?: string[];
	headings?: MarkdownHeading[];
	readingMinutes?: number;
	prev?: NeighborPost;
	next?: NeighborPost;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	headings = [],
	readingMinutes,
	prev,
	next,
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = tocHeadings.length >= 2;
const meta = category ? getCategoryByName(category) : undefined;
const [from, to] = meta?.gradient ?? ['#5ac8fa', '#0a84ff'];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<style>
			main {
				/* 外层栅格基准：封面左右边缘 = 正文左边缘 / 目录右边缘 */
				--article-width: 1024px;
				width: 100%;
				max-width: 100%;
				padding: 0;
			}
			main.no-toc {
				--article-width: 760px;
			}
			.post-frame {
				max-width: calc(var(--article-width) + 32px);
				margin: 0 auto;
				padding: 0 16px;
			}
			.reading-progress {
				position: fixed;
				inset: 0 0 auto;
				z-index: 60;
				height: 3px;
				pointer-events: none;
			}
			.reading-progress span {
				display: block;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, var(--color-brand), #64d2ff);
				transform: scaleX(0);
				transform-origin: left;
			}

			.post-header {
				display: flex;
				max-width: 860px;
				margin: 0 auto;
				padding: 40px 16px 28px;
				flex-direction: column;
				align-items: center;
				gap: 14px;
				text-align: center;
			}
			.post-header .pill {
				font-size: 13px;
			}
			.post-header h1 {
				margin: 0;
				font-size: clamp(1.8rem, 3.4vw, 2.35rem);
				line-height: 1.25;
				letter-spacing: -0.015em;
				text-wrap: balance;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: center;
				gap: 8px 18px;
				color: var(--color-text-muted);
				font-size: 15px;
			}
			.post-author {
				display: inline-flex;
				align-items: center;
				gap: 8px;
			}

			.post-cover {
				width: 100%;
				aspect-ratio: 21 / 9;
				max-height: 340px;
				border-radius: var(--radius-card);
			}
			.post-cover :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.post-cover .cover-placeholder :global(.category-icon) {
				--ci-size: 64px !important;
				--ci-radius: 16px !important;
			}
			.cover-chip {
				position: absolute;
				bottom: 20px;
				left: 20px;
				z-index: 2;
				padding: 8px 14px;
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: var(--radius-pill);
				background: rgba(28, 28, 30, 0.45);
				-webkit-backdrop-filter: blur(16px);
				backdrop-filter: blur(16px);
				color: #f5f5f7;
				font-size: 12px;
			}

			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: 56px;
				padding: 32px 0 96px;
			}
			.post-shell.has-toc {
				grid-template-columns: minmax(0, 1fr) 220px;
				align-items: start;
			}
			.post-article {
				min-width: 0;
			}

			/* 摘要：左侧强调线 + 小字角标，不再重复分类图标 */
			.post-summary {
				margin-bottom: 28px;
				padding: 14px 22px;
				border-radius: var(--radius-container);
				background: color-mix(in srgb, var(--color-bg-secondary) 70%, transparent);
				/* 强调线用内阴影绘制，保留 16px 圆角 */
				box-shadow: inset 3px 0 0 var(--color-brand);
			}
			.post-summary-label {
				display: block;
				margin-bottom: 2px;
				color: var(--color-accent-text);
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 0.08em;
			}
			.post-summary p {
				margin: 0;
				color: var(--color-text-secondary);
				font-size: 16px;
				line-height: 1.75;
			}

			/* 目录：无背景框，左侧细竖线导引 + 当前小节高亮条 */
			.table-of-contents {
				position: sticky;
				top: calc(var(--header-height) + 32px);
				max-height: calc(100vh - var(--header-height) - 64px);
				overflow: auto;
				font-size: 13px;
				line-height: 1.5;
				scrollbar-width: none;
			}
			.toc-title {
				margin: 0 0 12px;
				padding-left: 15px;
				color: var(--color-text-muted);
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 0.08em;
			}
			.table-of-contents ol {
				display: grid;
				gap: 4px;
				margin: 0;
				padding: 0;
				border-left: 1px solid var(--color-border);
				list-style: none;
			}
			.table-of-contents a {
				position: relative;
				display: block;
				padding: 5px 0 5px 14px;
				color: var(--color-text-muted);
				overflow-wrap: anywhere;
				transition: color 0.25s ease;
			}
			.table-of-contents a::before {
				content: '';
				position: absolute;
				top: 4px;
				bottom: 4px;
				left: -1px;
				width: 2px;
				border-radius: 2px;
				background: var(--color-brand);
				opacity: 0;
				transform: scaleY(0.4);
				transition:
					opacity 0.25s ease,
					transform 0.3s var(--ease-out);
			}
			.table-of-contents a:hover {
				color: var(--color-text);
			}
			.table-of-contents a.active {
				color: var(--color-text);
				font-weight: 500;
			}
			.table-of-contents a.active::before {
				opacity: 1;
				transform: none;
			}
			.table-of-contents .toc-depth-3 a {
				padding-left: 26px;
				font-size: 12.5px;
			}

			.prose {
				color: var(--color-text);
				font-size: 18px;
				line-height: 1.85;
				overflow-wrap: anywhere;
			}
			.prose :global(> h1:first-child) {
				display: none;
			}
			.prose :global(p) {
				margin: 0 0 1.35em;
			}
			.prose :global(h2) {
				margin: 2.2em 0 0.7em;
				font-size: 1.75rem;
				line-height: 1.35;
			}
			.prose :global(h3) {
				margin: 1.9em 0 0.6em;
				font-size: 1.35rem;
				line-height: 1.4;
			}
			.prose :global(h4) {
				margin: 1.7em 0 0.6em;
				font-size: 1.12rem;
			}
			.prose :global(ul),
			.prose :global(ol) {
				margin: 0 0 1.35em;
				padding-left: 1.35em;
			}
			.prose :global(li + li) {
				margin-top: 0.35em;
			}
			.prose :global(blockquote) {
				margin: 1.8em 0;
			}
			.prose :global(blockquote p:last-child) {
				margin-bottom: 0;
			}
			.prose :global(pre) {
				max-width: 100%;
				margin: 1.6rem 0 1.9rem;
				overflow: hidden !important;
				font-size: 0.86rem;
				line-height: 1.75;
				white-space: pre-wrap;
			}
			.prose :global(pre > code) {
				display: block;
				overflow-wrap: inherit;
				white-space: inherit;
			}
			.prose :global(img),
			.prose :global(video),
			.prose :global(iframe) {
				max-width: 100%;
				border-radius: var(--radius-container);
			}
			.prose :global(table) {
				display: block;
				max-width: 100%;
				overflow-x: auto;
				border-collapse: separate;
				border-spacing: 0;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-container);
				font-size: 0.95rem;
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 10px 14px;
				border-bottom: 1px solid var(--color-border);
				vertical-align: top;
			}
			.prose :global(th) {
				background: var(--color-bg-secondary);
				text-align: left;
			}
			.prose :global(tr:last-child td) {
				border-bottom: 0;
			}
			.prose :global(a) {
				text-decoration: underline;
				text-decoration-color: color-mix(in srgb, var(--color-link) 35%, transparent);
				text-underline-offset: 0.2em;
			}
			.prose :global(a:hover) {
				text-decoration-color: currentColor;
			}

			.post-footer {
				display: grid;
				gap: 28px;
				margin-top: 48px;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}
			.post-updated {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 14px;
			}
			.post-nav {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 12px;
			}
			.post-nav a {
				display: flex;
				flex-direction: column;
				gap: 8px;
				padding: 22px 24px;
				border-radius: var(--radius-card);
				background: var(--color-bg-secondary);
				color: var(--color-text);
			}
			.post-nav a:hover {
				background: var(--color-bg-hover);
				color: var(--color-text);
			}
			.post-nav span {
				color: var(--color-text-muted);
				font-size: 13px;
			}
			.post-nav strong {
				font-size: 17px;
				font-weight: 600;
				line-height: 1.5;
			}
			.post-nav .is-next {
				text-align: right;
			}

			@media (max-width: 1080px) {
				main {
					--article-width: 760px;
				}
				.post-shell,
				.post-shell.has-toc {
					grid-template-columns: minmax(0, 1fr);
					gap: 32px;
				}
				.table-of-contents {
					position: static;
					order: -1;
					max-height: none;
				}
			}
			@media (max-width: 720px) {
				.post-header {
					padding: 32px 16px 24px;
				}
				.post-cover {
					aspect-ratio: 16 / 9;
				}
				.post-shell {
					padding: 28px 0 72px;
					gap: 28px;
				}
				.prose {
					font-size: 17px;
					line-height: 1.82;
				}
				.prose :global(h2) {
					font-size: 1.45rem;
				}
				.prose :global(h3) {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
		<Header />
		<main class:list={[!showToc && 'no-toc']}>
			<header class="post-header">
				{
					category && (
						<a class="pill rise" href={meta ? `/categories/${meta.slug}/` : '/categories'}>
							{category}
						</a>
					)
				}
				<h1 class="rise d1">{title}</h1>
				<div class="post-meta rise d2">
					<span class="post-author"><Avatar variant="hero" loading="lazy" fetchpriority="auto" />{AUTHOR_NAME}</span>
					<FormattedDate date={pubDate} />
					{readingMinutes && <span>约 {readingMinutes} 分钟读完</span>}
				</div>
			</header>

			<div class="post-frame">
				<div class="post-cover cover-frame rise d3">
					{
						heroImage ? (
							typeof heroImage === 'string' ? (
								<img src={heroImage} alt="" width={1024} height={439} />
							) : (
								<Image src={heroImage} alt="" width={1024} height={439} />
							)
						) : (
							<div class="cover-placeholder" style={`--cover-from:${from};--cover-to:${to};`}>
								<CategoryIcon category={category ?? ''} size={64} tone="soft" />
							</div>
						)
					}
					{tags.length > 0 && <span class="cover-chip">{tags.slice(0, 3).join(' · ')}</span>}
				</div>

				<div class:list={['post-shell', showToc && 'has-toc']}>
				<article class="post-article">
					{
						description && (
							<div class="post-summary">
								<span class="post-summary-label">摘要</span>
								<p>{description}</p>
							</div>
						)
					}
					<div class="prose">
						<slot />
					</div>
					<footer class="post-footer">
						{
							updatedDate && (
								<p class="post-updated">
									最后更新于 <FormattedDate date={updatedDate} />
								</p>
							)
						}
						{tags.length > 0 && <div class="post-tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
						{
							(prev || next) && (
								<nav class="post-nav" aria-label="上一篇和下一篇">
									{prev && (
										<a href={prev.href}>
											<span>‹ 上一篇</span>
											<strong>{prev.title}</strong>
										</a>
									)}
									{next && (
										<a class="is-next" href={next.href}>
											<span>下一篇 ›</span>
											<strong>{next.title}</strong>
										</a>
									)}
								</nav>
							)
						}
					</footer>
				</article>
				{
					showToc && (
						<aside class="table-of-contents" aria-label="文章目录">
							<p class="toc-title">本文目录</p>
							<nav>
								<ol>
									{tocHeadings.map((heading) => (
										<li class={`toc-depth-${heading.depth}`}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
				</div>
			</div>
			<CodeCopy />
		</main>
		<Footer />

		<script>
			// 阅读进度条
			const bar = document.getElementById('reading-progress-bar');
			const article = document.querySelector<HTMLElement>('.post-article');
			if (bar && article) {
				let ticking = false;
				const update = () => {
					const rect = article.getBoundingClientRect();
					const total = rect.height - window.innerHeight * 0.6;
					const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
					bar.style.transform = `scaleX(${progress})`;
					ticking = false;
				};
				window.addEventListener(
					'scroll',
					() => {
						if (!ticking) {
							ticking = true;
							requestAnimationFrame(update);
						}
					},
					{ passive: true },
				);
				update();
			}

			// 目录高亮当前阅读的小节
			const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.table-of-contents a'));
			if (tocLinks.length && 'IntersectionObserver' in window) {
				const byId = new Map(tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
				const visible = new Set<string>();
				const headings = Array.from(byId.keys())
					.map((id) => document.getElementById(id))
					.filter((el): el is HTMLElement => Boolean(el));
				const setActive = (id: string) => {
					tocLinks.forEach((link) => {
						const active = byId.get(id) === link;
						link.classList.toggle('active', active);
						if (active) link.setAttribute('aria-current', 'true');
						else link.removeAttribute('aria-current');
					});
				};
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) visible.add(entry.target.id);
							else visible.delete(entry.target.id);
						});
						const first = headings.find((heading) => visible.has(heading.id));
						if (first) setActive(first.id);
					},
					{ rootMargin: '-80px 0px -65% 0px' },
				);
				headings.forEach((heading) => observer.observe(heading));
			}
		</script>
	</body>
</html>
