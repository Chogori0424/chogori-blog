---
import { Image } from 'astro:assets';
import type { ImageMetadata, MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata | string;
	category?: string;
	tags?: string[];
	headings?: MarkdownHeading[];
}

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = tocHeadings.length >= 2;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, 820px);
				gap: 2rem;
				box-sizing: border-box;
				width: 100%;
				max-width: 820px;
				margin: 0 auto;
				padding: 48px 24px 96px;
			}
			.post-shell.has-toc {
				grid-template-columns: minmax(0, 820px) minmax(180px, 240px);
				align-items: start;
				max-width: 1120px;
			}
			.post-article {
				min-width: 0;
				max-width: 820px;
				margin: 0;
				padding: 0;
			}
			.table-of-contents {
				position: sticky;
				top: 5.5rem;
				align-self: start;
				min-width: 0;
				max-width: 100%;
				max-height: calc(100vh - 7rem);
				overflow: auto;
				border: 1px solid var(--color-card-border);
				border-radius: var(--radius-card);
				padding: 1rem;
				background: var(--surface-soft);
				color: var(--color-text-muted);
				font-size: 0.9rem;
				line-height: 1.5;
			}
			.toc-title {
				margin: 0 0 0.75rem;
				color: var(--color-text);
				font-size: 0.85rem;
				font-weight: 800;
				letter-spacing: 0;
			}
			.table-of-contents ol {
				display: grid;
				gap: 0.25rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.table-of-contents a {
				display: block;
				border-left: 2px solid transparent;
				border-radius: 0 8px 8px 0;
				padding: 0.28rem 0 0.28rem 0.65rem;
				color: inherit;
				text-decoration: none;
				overflow-wrap: anywhere;
			}
			.table-of-contents a:hover,
			.table-of-contents a:focus-visible {
				border-left-color: var(--color-accent);
				color: var(--color-accent);
				outline: none;
			}
			.table-of-contents .toc-depth-3 a {
				padding-left: 1.35rem;
				font-size: 0.86rem;
			}
			.hero-image {
				min-width: 0;
				width: 100%;
				margin: 0 0 2rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 auto;
				border-radius: var(--radius-card);
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 100%;
				min-width: 0;
				margin: 0;
				padding: 0;
				color: var(--color-text);
				font-size: 18px;
				line-height: 1.85;
				letter-spacing: 0;
				overflow-wrap: anywhere;
			}
			.title {
				min-width: 0;
				margin-bottom: 2rem;
				padding: 0 0 1.25rem;
				text-align: left;
				border-bottom: 1px solid var(--color-border);
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.25rem, 4vw, 3rem);
				line-height: 1.18;
				letter-spacing: -0.02em;
				overflow-wrap: break-word;
				text-wrap: balance;
				line-break: loose;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				justify-content: flex-start;
				align-items: center;
				min-width: 0;
				margin-bottom: 0.75rem;
				color: var(--color-text-muted);
				font-size: 0.82rem;
				line-height: 1.5;
			}
			.badge,
			.tag {
				display: inline-flex;
				border: 1px solid var(--color-accent);
				border-radius: var(--radius-pill);
				padding: 0.15rem 0.55rem;
				background: var(--color-accent-muted);
				color: var(--color-text);
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1.45;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				justify-content: flex-start;
				min-width: 0;
				margin-top: 1rem;
			}
			.tag {
				font-size: 0.78rem;
			}
			.last-updated-on {
				width: 100%;
				font-style: italic;
			}
			.title hr {
				display: none;
			}
			:global(.post-article .prose > .title + h1) {
				display: none;
			}
			:global(.post-article .prose p) {
				margin: 0 0 1.35em;
			}
			:global(.post-article .prose h2) {
				margin: 2.4em 0 0.75em;
				font-size: 1.65rem;
				line-height: 1.32;
				letter-spacing: 0;
			}
			:global(.post-article .prose h3) {
				margin: 2em 0 0.7em;
				font-size: 1.35rem;
				line-height: 1.36;
				letter-spacing: 0;
			}
			:global(.post-article .prose h4) {
				margin: 1.8em 0 0.65em;
				font-size: 1.15rem;
				line-height: 1.4;
			}
			:global(.post-article .prose ul),
			:global(.post-article .prose ol) {
				margin: 0 0 1.35em;
				padding-left: 1.35em;
			}
			:global(.post-article .prose li + li) {
				margin-top: 0.35em;
			}
			:global(.post-article .prose blockquote) {
				margin: 1.8em 0;
				padding: 0.1em 0 0.1em 1em;
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-muted);
			}
			:global(.post-article .prose pre) {
				max-width: 100%;
				margin: 1.5rem 0 1.8rem;
				overflow: hidden !important;
				overflow-x: hidden !important;
				overflow-wrap: anywhere;
				font-size: 0.9rem;
				line-height: 1.7;
				white-space: pre-wrap;
			}
			:global(.post-article .prose pre > code) {
				display: block;
				overflow-wrap: inherit;
				white-space: inherit;
			}
			:global(.post-article .prose :not(pre) > code) {
				max-width: 100%;
				font-size: 0.92em;
				overflow-wrap: anywhere;
			}
			:global(.post-article .prose a) {
				overflow-wrap: anywhere;
			}
			:global(.post-article .prose img),
			:global(.post-article .prose picture),
			:global(.post-article .prose video),
			:global(.post-article .prose iframe) {
				max-width: 100%;
			}
			:global(.post-article .prose table) {
				display: block;
				max-width: 100%;
				overflow-x: auto;
				border-collapse: collapse;
				font-size: 0.95rem;
			}
			:global(.post-article .prose th),
			:global(.post-article .prose td) {
				padding: 0.55rem 0.7rem;
				border: 1px solid var(--color-border);
				vertical-align: top;
			}
			@media (max-width: 1100px) {
				.post-shell,
				.post-shell.has-toc {
					grid-template-columns: minmax(0, 820px);
					max-width: 820px;
				}
				.table-of-contents {
					position: static;
					order: -1;
					max-height: none;
				}
			}
			@media (max-width: 720px) {
				.post-shell {
					width: 100%;
					max-width: 100%;
					padding: 28px 16px 72px;
				}
				.prose {
					font-size: 17px;
					line-height: 1.82;
				}
				.title {
					margin-bottom: 1.75rem;
				}
				.title h1 {
					font-size: clamp(1.9rem, 8vw, 2.35rem);
					line-height: 1.2;
					letter-spacing: -0.01em;
				}
				:global(.post-article .prose h2) {
					font-size: 1.42rem;
				}
				:global(.post-article .prose h3) {
					font-size: 1.2rem;
				}
				.table-of-contents {
					border-radius: var(--radius-card);
					padding: 0.9rem;
					font-size: 0.88rem;
				}
				:global(.post-article .prose pre) {
					margin-right: -6px;
					margin-left: -6px;
					font-size: 0.84rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class:list={['post-shell', showToc && 'has-toc']}>
				<article class="post-article">
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose">
						<div class="title">
							<div class="meta">
								{category && <span class="badge">{category}</span>}
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											更新于 <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							{tags.length > 0 && <div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
							<hr />
						</div>
						<slot />
					</div>
				</article>
				{
					showToc && (
						<aside class="table-of-contents" aria-label="文章目录">
							<p class="toc-title">目录</p>
							<nav>
								<ol>
									{tocHeadings.map((heading) => (
										<li class={`toc-depth-${heading.depth}`}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
			</div>
			<CodeCopy />
		</main>
		<Footer />
	</body>
</html>
